<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nass</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Nass.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

</head>
<body>
    <header>
        <!-- Navigation -->
        <nav class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-20">

                    <!-- Logo -->
                    <div class="flex-shrink-0">
                        <img src="~/images/nassad.png" alt="NASS Advertising & Designing" class="h-16">
                    </div>

                    <!-- Desktop Menu -->
                    <div class="hidden md:flex items-center gap-8">
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('home')" class="hover:text-[#ff6b35]">Home</button></a>
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('services')" class="hover:text-[#ff6b35]">How It Works</button></a>
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('about')" class="hover:text-[#ff6b35]">About</button></a>
                        <a asp-controller="Home" asp-action="index">
                            <button onclick="scrollToSection('contact')" class="bg-[#ff6b35] text-white px-6 py-2 rounded-lg">
                                Submit Project
                            </button>
                        </a>
                        <button onclick="window.location.href='@Url.Action("login", "home")'"
                                class="bg-red-500 text-white px-5 py-2 rounded">
                            Login
                        </button>
                    </div>

                    <!-- Mobile Hamburger -->
                    <button id="menuBtn" class="md:hidden text-2xl">
                        <i class="fas fa-bars"></i>
                    </button>

                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden md:hidden bg-white border-t shadow-lg">
                <div class="flex flex-col p-4 space-y-4">
                    <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('home')" class="text-left">Home</button></a>
                    <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('services')" class="text-left">How It Works</button></a>
                    <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('about')" class="text-left">About</button></a>
                    <a asp-controller="Home" asp-action="index">
                        <button onclick="scrollToSection('contact')" class="bg-[#ff6b35] text-white px-4 py-2 rounded">
                            Submit Project
                        </button>
                    </a>
                    <button onclick="window.location.href='@Url.Action("login", "home")'"
                            class="bg-red-500 text-white px-4 py-2 rounded">
                        Login
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <!-- Footer -->
    <footer class="py-12" style="background-color: #1a1a1a; color: white;">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                <div>
                    <img src="~/images/nassad.png" alt="NASS Advertising & Designing" class="h-16 w-30 mb-3" style="background-color: white; border-radius: 20px;">
                    <p class="text-gray-400">
                        Connecting clients with top printing and design agencies through our innovative marketplace platform.
                    </p>
                </div>

                <div>
                    <h4 class="mb-4">Quick Links</h4>
                    <div class="space-y-1">
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('home')" class="block text-gray-400 hover:text-[#ff6b35] transition-colors">Home</button></a>
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('services')" class="block text-gray-400 hover:text-[#ff6b35] transition-colors">How It Works</button></a>
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('about')" class="block text-gray-400 hover:text-[#ff6b35] transition-colors">About</button></a>
                        <a asp-controller="Home" asp-action="index"><button onclick="scrollToSection('contact')" class="block text-gray-400 hover:text-[#ff6b35] transition-colors">Submit Project</button></a>
                    </div>

                    <h4 class="mb-4">Legal & Privacy</h4>
                    <div class="space-y-4">
                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a> |
                        <a asp-controller="Home" asp-action="Terms">Terms & Conditions</a> |
                        <a asp-controller="Home" asp-action="Refund">Refund Policy</a>

                    </div>
                </div>
                <div>
                    <h4 class="mb-4">Follow Us</h4>
                    <div class="flex gap-4">

                        <a href="https://www.youtube.com/nassadca" class="bg-white/10 p-3 rounded-lg hover:bg-[#ff6b35] transition-all hover:scale-110 hover:rotate-6">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                            </svg>
                        </a>
                        <a href="https://www.instagram.com/nassadca/" class="bg-white/10 p-3 rounded-lg hover:bg-[#ff6b35] transition-all hover:scale-110 hover:rotate-6">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7.75 2C4.57 2 2 4.57 2 7.75v8.5C2 19.43 4.57 22 7.75 22h8.5C19.43 22 22 19.43 22 16.25v-8.5C22 4.57 19.43 2 16.25 2h-8.5zm0 1.5h8.5A4.75 4.75 0 0 1 21 7.75v8.5A4.75 4.75 0 0 1 16.25 21h-8.5A4.75 4.75 0 0 1 3 16.25v-8.5A4.75 4.75 0 0 1 7.75 3.5z" />
                                <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 1.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7z" />
                                <circle cx="17.5" cy="6.5" r="1.25" />
                            </svg>
                        </a>
                        <a href="https://www.linkedin.com/in/nass-advertising-and-designing/" class="bg-white/10 p-3 rounded-lg hover:bg-[#ff6b35] transition-all hover:scale-110 hover:rotate-6">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-800 pt-8 text-center text-gray-400">
                <p>&copy; <span id="currentYear"></span> NASS Advertising & Designing. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
