@{
    Layout = null;
    ViewData["Title"] = "HomePage";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>NASS Advertising & Designing</title>
    <meta name="description" content="Professional printing & creative design solutions" />

    <!-- Fonts & Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>


    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bg-white text-gray-900">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">

                <!-- Logo -->
                <div class="flex-shrink-0">
                    <img src="~/images/nassad.png" alt="NASS Advertising & Designing" class="h-16">
                </div>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-8">
                    <button onclick="scrollToSection('home')" class="hover:text-[#ff6b35]">Home</button>
                    <button onclick="scrollToSection('services')" class="hover:text-[#ff6b35]">How It Works</button>
                    <button onclick="scrollToSection('about')" class="hover:text-[#ff6b35]">About</button>
                    <button onclick="scrollToSection('contact')" class="bg-[#ff6b35] text-white px-6 py-2 rounded-lg">
                        Submit Project
                    </button>
                    <button onclick="window.location.href='@Url.Action("login", "home")'"
                            class="bg-red-500 text-white px-5 py-2 rounded">
                        Login
                    </button>
                </div>

                <!-- Mobile Hamburger -->
                <button id="menuBtn" class="md:hidden text-2xl">
                    <i class="fas fa-bars"></i>
                </button>

            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden md:hidden bg-white border-t shadow-lg">
            <div class="flex flex-col p-4 space-y-4">
                <button onclick="scrollToSection('home')" class="text-left">Home</button>
                <button onclick="scrollToSection('services')" class="text-left">How It Works</button>
                <button onclick="scrollToSection('about')" class="text-left">About</button>
                <button onclick="scrollToSection('contact')" class="bg-[#ff6b35] text-white px-4 py-2 rounded">
                    Submit Project
                </button>
                <button onclick="window.location.href='@Url.Action("login", "home")'"
                        class="bg-red-500 text-white px-4 py-2 rounded">
                    Login
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20" style="background: linear-gradient(to bottom right, #f7b801, #ff6b35, #1a1a1a);">
        <!-- Animated background shapes -->
        <div class="hero-blob-1 absolute top-20 left-10 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
        <div class="hero-blob-2 absolute bottom-20 right-10 w-48 h-48 rounded-full blur-3xl" style="background-color: rgba(247, 184, 1, 0.2);"></div>
        <div class="hero-blob-3 absolute top-1/2 left-1/3 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>

        <!-- Floating icons -->
        <div class="floating-icon absolute top-1/4 left-1/4">
            <svg class="w-12 h-12 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
        </div>
        <div class="floating-icon absolute top-1/3 right-1/4">
            <svg class="w-16 h-16 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
            </svg>
        </div>
        <div class="floating-icon absolute bottom-1/4 left-1/3">
            <svg class="w-10 h-10 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
            </svg>
        </div>

        <!-- Hero content -->
        <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <div class="fade-in visible">
                <h1 class="text-4xl sm:text-5xl md:text-7xl text-white mb-6">
                    Connect with Top <br>
                    <span style="color: #f7b801;">Printing & Design Agencies</span>
                </h1>
                <p class="text-xl sm:text-2xl text-white/90 mb-8 max-w-2xl mx-auto">
                    Submit your project and get instant responses from verified agencies. First to confirm wins your project.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button onclick="scrollToSection('contact')" class="btn bg-white text-[#1a1a1a] px-8 py-4 rounded-lg hover:bg-[#f7b801] hover:text-white">
                        Submit Your Project
                    </button>
                    <button onclick="scrollToSection('services')" class="btn bg-transparent border-2 border-white text-white px-8 py-4 rounded-lg hover:bg-white hover:text-[#1a1a1a]">
                        How It Works
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-20" style="background: linear-gradient(to bottom, #ffffff, #f9fafb);">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="fade-in text-center mb-16">
                <h2 class="text-3xl sm:text-5xl mb-4" style="color: #1a1a1a;">
                    How It <span style="color: #ff6b35;">Works</span>
                </h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    A simple 3-step process to connect you with the best printing and design agencies
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
                <!-- Step 1 -->
                <div class="fade-in service-card h-full bg-white rounded-lg p-6 border-2 border-transparent text-center">
                    <div class="service-icon mb-4 inline-flex p-4 rounded-full" style="background-color: rgba(255, 107, 53, 0.2);">
                        <svg class="w-8 h-8" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                    </div>
                    <div class="text-5xl mb-4" style="color: #ff6b35;">1</div>
                    <h3 class="mb-2" style="color: #1a1a1a;">Submit Your Project</h3>
                    <p class="text-gray-600">Fill out a simple form with your project requirements, budget, and timeline.</p>
                </div>

                <!-- Step 2 -->
                <div class="fade-in service-card h-full bg-white rounded-lg p-6 border-2 border-transparent text-center">
                    <div class="service-icon mb-4 inline-flex p-4 rounded-full" style="background-color: rgba(247, 184, 1, 0.2);">
                        <svg class="w-8 h-8" style="color: #f7b801;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                        </svg>
                    </div>
                    <div class="text-5xl mb-4" style="color: #f7b801;">2</div>
                    <h3 class="mb-2" style="color: #1a1a1a;">Agencies Get Notified</h3>
                    <p class="text-gray-600">Your project is instantly sent to our network of verified printing and design agencies.</p>
                </div>

                <!-- Step 3 -->
                <div class="fade-in service-card h-full bg-white rounded-lg p-6 border-2 border-transparent text-center">
                    <div class="service-icon mb-4 inline-flex p-4 rounded-full" style="background-color: rgba(255, 107, 53, 0.2);">
                        <svg class="w-8 h-8" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="text-5xl mb-4" style="color: #ff6b35;">3</div>
                    <h3 class="mb-2" style="color: #1a1a1a;">First to Confirm Wins</h3>
                    <p class="text-gray-600">The first agency to confirm gets your project. Fast, efficient, and competitive.</p>
                </div>
            </div>

            <div class="fade-in text-center mb-12">
                <h3 class="text-2xl sm:text-3xl mb-4" style="color: #1a1a1a;">
                    Available <span style="color: #ff6b35;">Services</span>
                </h3>
                <p class="text-gray-600 max-w-2xl mx-auto mb-8">
                    Our network of agencies can handle all your printing and design needs
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Service 1 -->
                <div class="fade-in bg-gradient-to-br from-gray-50 to-white p-6 rounded-lg border border-gray-200">
                    <div class="mb-4 inline-flex p-3 rounded-lg" style="background-color: rgba(255, 107, 53, 0.1);">
                        <svg class="w-6 h-6" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                        </svg>
                    </div>
                    <h4 class="mb-2" style="color: #1a1a1a;">Digital Printing</h4>
                    <p class="text-sm text-gray-600">Business cards, flyers, posters, and large format prints</p>
                </div>

                <!-- Service 2 -->
                <div class="fade-in bg-gradient-to-br from-gray-50 to-white p-6 rounded-lg border border-gray-200">
                    <div class="mb-4 inline-flex p-3 rounded-lg" style="background-color: rgba(247, 184, 1, 0.1);">
                        <svg class="w-6 h-6" style="color: #f7b801;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                        </svg>
                    </div>
                    <h4 class="mb-2" style="color: #1a1a1a;">Graphic Design</h4>
                    <p class="text-sm text-gray-600">Logo design, brand identity, and marketing materials</p>
                </div>

                <!-- Service 3 -->
                <div class="fade-in bg-gradient-to-br from-gray-50 to-white p-6 rounded-lg border border-gray-200">
                    <div class="mb-4 inline-flex p-3 rounded-lg" style="background-color: rgba(255, 107, 53, 0.1);">
                        <svg class="w-6 h-6" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <h4 class="mb-2" style="color: #1a1a1a;">Brochure Design</h4>
                    <p class="text-sm text-gray-600">Professional brochures and catalogs for your business</p>
                </div>

                <!-- Service 4 -->
                <div class="fade-in bg-gradient-to-br from-gray-50 to-white p-6 rounded-lg border border-gray-200">
                    <div class="mb-4 inline-flex p-3 rounded-lg" style="background-color: rgba(247, 184, 1, 0.1);">
                        <svg class="w-6 h-6" style="color: #f7b801;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h4 class="mb-2" style="color: #1a1a1a;">Banner & Signage</h4>
                    <p class="text-sm text-gray-600">Custom banners, signage, and event displays</p>
                </div>

                <!-- Service 5 -->
                <div class="fade-in bg-gradient-to-br from-gray-50 to-white p-6 rounded-lg border border-gray-200">
                    <div class="mb-4 inline-flex p-3 rounded-lg" style="background-color: rgba(255, 107, 53, 0.1);">
                        <svg class="w-6 h-6" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                        </svg>
                    </div>
                    <h4 class="mb-2" style="color: #1a1a1a;">Brand Identity</h4>
                    <p class="text-sm text-gray-600">Complete branding packages and style guides</p>
                </div>

                <!-- Service 6 -->
                <div class="fade-in bg-gradient-to-br from-gray-50 to-white p-6 rounded-lg border border-gray-200">
                    <div class="mb-4 inline-flex p-3 rounded-lg" style="background-color: rgba(247, 184, 1, 0.1);">
                        <svg class="w-6 h-6" style="color: #f7b801;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                    </div>
                    <h4 class="mb-2" style="color: #1a1a1a;">Packaging Design</h4>
                    <p class="text-sm text-gray-600">Eye-catching product packaging solutions</p>
                </div>
            </div>
        </div>
    </section>


    <!-- About Section -->
    <section id="about" class="py-20 bg-white">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div class="fade-in">
                    <h2 class="text-3xl sm:text-5xl mb-6" style="color: #1a1a1a;">
                        About <span style="color: #ff6b35;">NASS</span>
                    </h2>
                    <p class="text-gray-600 mb-6">
                        NASS is a revolutionary marketplace platform connecting clients with the best printing and design agencies.
                        We've simplified the process of finding quality printing and design services by creating a competitive,
                        transparent platform where agencies bid for your projects in real-time.
                    </p>
                    <p class="text-gray-600 mb-8">
                        Our platform ensures you get the fastest service possible. When you submit a project, it's instantly
                        broadcast to our network of verified agencies. The first agency to confirm your project wins the opportunity
                        to work with you. This competitive model guarantees speed, quality, and the best rates.
                    </p>
                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <div class="text-4xl mb-2" style="color: #ff6b35;">50+</div>
                            <p class="text-gray-600">Partner Agencies</p>
                        </div>
                        <div>
                            <div class="text-4xl mb-2" style="color: #f7b801;">24/7</div>
                            <p class="text-gray-600">Instant Matching</p>
                        </div>
                    </div>
                </div>

                <div class="fade-in relative">
                    <div class="grid grid-cols-2 gap-4">
                        <!-- Value 1 -->
                        <div class="bg-gradient-to-br from-gray-50 to-white p-6 rounded-xl shadow-md border border-gray-100 hover:-translate-y-1 transition-transform">
                            <div class="mb-3">
                                <svg class="w-8 h-8" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                            <h4 class="mb-2" style="color: #1a1a1a;">Instant Response</h4>
                            <p class="text-sm text-gray-600">Get matched with agencies in real-time. No waiting, no delays.</p>
                        </div>

                        <!-- Value 2 -->
                        <div class="bg-gradient-to-br from-gray-50 to-white p-6 rounded-xl shadow-md border border-gray-100 hover:-translate-y-1 transition-transform">
                            <div class="mb-3">
                                <svg class="w-8 h-8" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h4 class="mb-2" style="color: #1a1a1a;">Verified Agencies</h4>
                            <p class="text-sm text-gray-600">All agencies in our network are verified and quality-checked.</p>
                        </div>

                        <!-- Value 3 -->
                        <div class="bg-gradient-to-br from-gray-50 to-white p-6 rounded-xl shadow-md border border-gray-100 hover:-translate-y-1 transition-transform">
                            <div class="mb-3">
                                <svg class="w-8 h-8" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h4 class="mb-2" style="color: #1a1a1a;">Competitive Rates</h4>
                            <p class="text-sm text-gray-600">Competition ensures you get the best prices for quality work.</p>
                        </div>

                        <!-- Value 4 -->
                        <div class="bg-gradient-to-br from-gray-50 to-white p-6 rounded-xl shadow-md border border-gray-100 hover:-translate-y-1 transition-transform">
                            <div class="mb-3">
                                <svg class="w-8 h-8" style="color: #ff6b35;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <h4 class="mb-2" style="color: #1a1a1a;">Secure Platform</h4>
                            <p class="text-sm text-gray-600">Your project details and information are completely secure.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact" class=" py-20 bg-gray-50">
        <div class="container mx-auto px-6 grid lg:grid-cols-0 gap-12">

            <!-- Info -->
            <div>
                <h2 class="text-4xl mb-6">Get In Touch</h2>
                <p class="text-gray-600 mb-6">
                    Ready to start your project? Contact us today.
                </p>

                <p class="mb-2"><strong>Phone:</strong> +1 (647) 913-1282</p>
                <p class="mb-6"><strong>Email:</strong> support@nassad.ca</p>
            </div>

            <!-- Form -->
            <!-- Form Container -->
            <form id="orderForm" class="max-w-md mx-auto bg-white p-6 rounded-xl shadow-lg space-y-4">
                <h2 class="text-2xl font-bold text-center mb-4">Submit Your Order</h2>

                <input name="CustomerName" required placeholder="Company Name"  class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <input name="CustomerPhone" type="tel"
                       required
                       placeholder="6470000000"
                       pattern="[0-9]{10}"
                       maxlength="10"
                       inputmode="numeric"
                       title="Phone number must be exactly 10 digits"  class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <input name="CustomerEmail" required placeholder="Email Address" class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <input name="CustomerAddress" required placeholder="your Address" class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <input type="url" name="transUrl" required placeholder="Share your URL project : wetransfer, DropBox, OneDrive, GoogleDrive" class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />

                <select name="Trans_categories" required class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Select Service</option>
                    <option value="small format">Small format printing</option>
                    <option value="menus">Menus</option>
                    <option value="brochures">Brochures</option>
                    <option value="flyers">Flyers</option>
                    <option value="business card">Business Card</option>
                    <option value="retail printing">Retail printing</option>
                    <option value="banners">Banners</option>
                    <option value="fabric printing">Fabric Printing</option>
                    <option value="just frame">Indoor Frame (please describe measurements)</option>
                    <option value="frame fabric">Indoor Frame with Fabric (please describe measurements)</option>
                    <option value="custom service">Custom Service</option>
                </select>

                <textarea name="Trans_description" required placeholder="Project details" class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>

                <!-- Submit Button -->
