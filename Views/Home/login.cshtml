@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            min-height: 100vh;
            background-image: url("https://t3.ftcdn.net/jpg/09/50/17/64/360_F_950176443_XQGPTseUunB0UMYARE4DqORCKiwD3Izl.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 20px 40px rgba(0,0,0,0.25);
        }

        .login-title {
            font-weight: 600;
        }

        .form-control {
            height: 48px;
            border-radius: 10px;
        }

        .btn-login {
            height: 48px;
            border-radius: 10px;
            background-color: orange;
            color: white;
            font-weight: 500;
            transition: background 0.3s;
        }

            .btn-login:hover {
                background-color: #5a0fcc;
            }

        .btn-agency {
            background-color: #6610f2;
            color: white;
            font-weight: 500;
            border-radius: 12px;
            transition: background 0.3s;
        }

            .btn-agency:hover {
                background-color: #5208c0;
            }

        .btn-customer {
            background-color: #0d6efd;
            color: white;
            font-weight: 500;
            border-radius: 12px;
            transition: background 0.3s;
        }

            .btn-customer:hover {
                background-color: #0a58ca;
            }

        @@media (max-width: 576px) {
            .login-card {
                padding: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="card p-4" style="width: 350px;">
        <h3 class="text-center mb-4">LOGIN</h3>
        <div class="mb-3">
            <input type="text" id="tenat" class="form-control" placeholder="Tenat ID">
        </div>
        <div class="mb-3">
            <input type="password" id="password" class="form-control" placeholder="Password">
        </div>
        <div class="d-grid gap-2">
            <button class="btn btn-primary" onclick="login('Customer')">Login as Customer</button>
            <button class="btn btn-warning" onclick="login('Agency')">Login as Agency</button>
        </div>
        <div id="alertContainer" class="mt-3"></div>
    </div>

    <script>


        function showAlert(message, type) {
            const container = document.getElementById('alertContainer');
            container.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show mt-3" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
        }

        // Optional: show popup if user already logged in
        window.addEventListener('DOMContentLoaded', () => {
            const token = localStorage.getItem('token');
            const tenat = localStorage.getItem('tenant');
            const userType = localStorage.getItem('userType');
            if (token) showPopup(`Welcome back ${tenat} (${userType})! 🎉`);
        });

        function showPopup(message) {
            const popup = document.createElement('div');
            popup.style.position = 'fixed';
            popup.style.top = '20px';
            popup.style.right = '20px';
            popup.style.padding = '15px 25px';
            popup.style.backgroundColor = '#6610f2';
            popup.style.color = 'white';
            popup.style.fontWeight = '500';
            popup.style.borderRadius = '10px';
            popup.style.boxShadow = '0 4px 10px rgba(0,0,0,0.25)';
            popup.style.zIndex = 9999;
            popup.style.opacity = 0;
            popup.style.transition = 'opacity 0.5s';
            popup.innerText = message;
            document.body.appendChild(popup);

            setTimeout(() => popup.style.opacity = 1, 50);
            setTimeout(() => { popup.style.opacity = 0; setTimeout(() => popup.remove(), 500); }, 3000);
        }
    </script>
    <script>
        async function login(userType) {
            const tenat = document.getElementById('tenat').value.trim();
            const password = document.getElementById('password').value.trim();

            if (!tenat || !password) {
                showAlert('Please enter Tenat and password', 'warning');
                return;
            }

            try {
                const response = await fetch('/api/Login/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        tenat: tenat,
                        password: password,
                        userType: userType
                    })
                });

                const data = await response.json();

                if (!response.ok) {
                    showAlert(data.message || 'Login failed', 'danger');
                    return;
                }

                // ✅ Save auth data
                localStorage.setItem('token', data.token);
                localStorage.setItem('tenant', data.tenat);
                localStorage.setItem('userType', data.role);

                showAlert(data.message, 'success');

                setTimeout(() => {
                    window.location.href = '/Home/Dashboard';
                }, 600);

            } catch (error) {
                console.error('Login error:', error);
                showAlert('Server error, please try again later', 'danger');
            }
        }

        function showAlert(message, type) {
            const container = document.getElementById('alertContainer');
            container.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show mt-3" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }
    </script>


</body>
</html>
